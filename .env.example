# Copy to .env and fill in from Supabase: Project Settings > API Keys.
# Never put the service_role key here. It bypasses Row Level Security.
# Use the anon OR publishable key, leave the other line empty.
# All three values below must come from the SAME Supabase project.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Leave blank to hide the demo button on the login screen.
# The password must match the demo user in Supabase Auth exactly.
# Expo bakes these in at build time, so after any edit run npm run web:clean
# (or npm run tunnel). A plain npm run web can serve cached old values.
EXPO_PUBLIC_DEMO_EMAIL=demo@questlog.app
EXPO_PUBLIC_DEMO_PASSWORD=
