# Copy this file to .env and fill in the values from your Supabase project.
# Dashboard > Project Settings > API Keys (or the Connect dialog).
#
# These two values are safe to ship in a client app: Row Level Security is what
# protects your data, not the anon/publishable key.
# NEVER put the service_role key here. That key bypasses RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Either name works. Use whichever key the dashboard shows you.
# Older projects: anon public key (eyJ...)
# Newer projects: publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: powers the "Try the demo account" button on the login screen.
# Leave blank to hide the button.
EXPO_PUBLIC_DEMO_EMAIL=demo@questlog.app
EXPO_PUBLIC_DEMO_PASSWORD=
